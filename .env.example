# Required for AI-powered analysis and tutor chat
GEMINI_API_KEY=

# Optional Notion import/export. Keep this server-side token private.
NOTION_API_KEY=

# Optional flashcard persistence. Disabled by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_FLASHCARD_PERSISTENCE=false
ENABLE_FLASHCARD_PERSISTENCE=false

# Optional reminder emails
RESEND_API_KEY=
MY_EMAIL=
REMIND_CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
